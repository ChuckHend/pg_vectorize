# Copy to .env and edit. docker compose reads .env from this directory.

# --- What to run yourself ------------------------------------------------------------
# The server and the worker always run. Postgres and TEI (embeddings) are optional
# profiles. Most production setups use a managed Postgres and a hosted embedding
# provider: then delete this line, and set DATABASE_URL and a provider below.
COMPOSE_PROFILES=postgres,tei

# --- Postgres ------------------------------------------------------------------------
# Password for the bundled Postgres (profile `postgres`). Ignored otherwise.
POSTGRES_PASSWORD=change-me

# Your own Postgres with pgvector (RDS, Neon, ...). Unset, this points at the bundled one.
# DATABASE_URL=postgresql://user:password@your-host:5432/postgres

# --- Embeddings ----------------------------------------------------------------------
# The provider is chosen by the prefix of the `model` you pass when creating a job:
# `openai/...`, `voyage/...`, `cohere/...`, `portkey/...`, or anything else for the
# service at EMBEDDING_SVC_URL (TEI, vector-serve). Set the credentials for the ones you
# use. They go to both the server and the worker. See docs/server/configuration.md.
#
# openai/text-embedding-3-small
# OPENAI_API_KEY=
# An OpenAI-compatible gateway or proxy (must end in /v1). Default is api.openai.com.
# OPENAI_BASE_URL=
#
# voyage/voyage-3-lite
# VOYAGE_API_KEY=
#
# cohere/embed-english-v3.0
# CO_API_KEY=
#
# portkey/text-embedding-ada-002
# PORTKEY_API_KEY=
# PORTKEY_VIRTUAL_KEY=
#
# Self-hosted, e.g. sentence-transformers/... or BAAI/...: the bundled TEI (profile
# `tei`), or your own endpoint. The URL must end in /v1.
# EMBEDDING_SVC_URL=http://tei:3000/v1
# EMBEDDING_SVC_API_KEY=

# The model the bundled TEI serves (profile `tei`). Keep it the same as the `model` you
# pass when creating a vectorize job: TEI ignores the requested name and always uses
# this one. Changing the model means re-embedding every table (vector columns are typed
# by dimension), so pick it before loading data. bge-base is a starting point, not a
# recommendation: see "Choosing an embedding model" in docs/production.md.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Optional overrides (defaults shown).
# SERVER_PORT=8080
# NUM_SERVER_WORKERS=8
# DATABASE_POOL_MAX=    # unset: 2 * NUM_SERVER_WORKERS + 2 (18 at the default)
# RUST_LOG=info
# PG_SHARED_BUFFERS=1GB
# PG_EFFECTIVE_CACHE_SIZE=3GB
# PG_MAINTENANCE_WORK_MEM=512MB
# VECTORIZE_SERVER_IMAGE=ghcr.io/chuckhend/vectorize-server:latest
